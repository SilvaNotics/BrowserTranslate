    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
