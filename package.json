{
  "name": "browser-translate",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "postinstall": "wxt prepare",
    "prepare:ocr": "node scripts/prepare-ocr.mjs && node scripts/notices.mjs",
